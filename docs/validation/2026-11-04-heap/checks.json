[
  {
    "name": "host-kernel",
    "command": [
      "cargo",
      "test",
      "-p",
      "kryo-core",
      "-p",
      "kryo-hal",
      "-p",
      "kryo-interfaces",
      "--target",
      "x86_64-unknown-linux-gnu",
      "--target-dir",
      "../host-target",
      "--locked",
      "--offline"
    ],
    "exit_code": 0
  },
  {
    "name": "host-user",
    "command": [
      "cargo",
      "test",
      "--manifest-path",
      "userspace/Cargo.toml",
      "-p",
      "kryo-libsys",
      "-p",
      "kryo-services",
      "--target",
      "x86_64-unknown-linux-gnu",
      "--target-dir",
      "../host-user-target",
      "--locked",
      "--offline"
    ],
    "exit_code": 0
  },
  {
    "name": "python",
    "command": [
      "python3",
      "-m",
      "unittest",
      "discover",
      "-s",
      "tools"
    ],
    "exit_code": 0
  },
  {
    "name": "headers",
    "command": [
      "python3",
      "tools/check_c_headers.py",
      "--output",
      "../header-checks"
    ],
    "exit_code": 0
  },
  {
    "name": "clippy",
    "command": [
      "cargo",
      "clippy",
      "--workspace",
      "--all-features",
      "--target-dir",
      "../clippy-target",
      "--locked",
      "--offline",
      "--",
      "-D",
      "warnings"
    ],
    "exit_code": 0
  }
]
